{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-request.v1",
  "title": "Evidence-constrained semantic request v1",
  "type": "object",
  "required": [
    "request_version",
    "request_id",
    "question",
    "domain_context",
    "session"
  ],
  "properties": {
    "request_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/ref_id"},
    "question": {"type": "string", "minLength": 1, "maxLength": 8192},
    "domain_context": {
      "type": "object",
      "required": ["domain_pack_ref", "authorized_catalog"],
      "properties": {
        "domain_pack_ref": {"$ref": "#/$defs/domain_pack_ref"},
        "authorized_catalog": {
          "type": "object",
          "required": ["candidate_ids", "max_data_level"],
          "properties": {
            "candidate_ids": {
              "type": "array",
              "items": {"$ref": "#/$defs/ref_id"},
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true
            },
            "max_data_level": {"enum": ["L0", "L1"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["session_id", "turn_index", "slot_observations"],
      "properties": {
        "session_id": {"$ref": "#/$defs/ref_id"},
        "turn_index": {"type": "integer", "minimum": 0, "maximum": 1000},
        "slot_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/slot_observation"},
          "maxItems": 64
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "ref_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domain_pack_ref": {
      "type": "object",
      "required": ["domain_pack_id", "version", "manifest_sha256"],
      "properties": {
        "domain_pack_id": {"$ref": "#/$defs/ref_id"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean"]
    },
    "slot_observation": {
      "type": "object",
      "required": ["slot_id", "values", "evidence_refs", "source"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/ref_id"},
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/scalar"},
          "maxItems": 16
        },
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_id"},
          "maxItems": 32,
          "uniqueItems": true
        },
        "source": {"const": "explicit_session"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
