{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-source-common.v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "readonly": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "single_table": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "timeout": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "cancel": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "pooling": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "tls": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "network": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        },
        "multi_table": {
          "enum": [
            "supported",
            "unsupported",
            "not_applicable"
          ]
        }
      },
      "required": [
        "readonly",
        "single_table",
        "timeout",
        "cancel",
        "pooling",
        "tls",
        "network",
        "multi_table"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorized_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 4096
        },
        "domain_pack": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "manifest_sha256"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_sha256",
        "authorized_object_ids",
        "domain_pack",
        "policy"
      ],
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "properties": {
        "id": {
          "const": "sqlite"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
