{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "typed-decision-trace-event.v1",
  "title": "Typed decision trace event v1",
  "type": "object",
  "required": [
    "event_type",
    "trace_version",
    "request_id",
    "recorded_at",
    "domain_pack_ref",
    "decision",
    "thresholds",
    "executed_action",
    "component_versions",
    "budget_snapshot"
  ],
  "properties": {
    "event_type": {"const": "typed_decision"},
    "trace_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "domain_pack_ref": {
      "type": "object",
      "required": ["domain_pack_id", "version", "manifest_sha256"],
      "properties": {
        "domain_pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "decision": {"$ref": "typed-decision.v1"},
    "thresholds": {
      "type": "object",
      "required": ["accept_min", "clarify_min", "abstain_below", "calibration_version"],
      "properties": {
        "accept_min": {"type": "number", "minimum": 0, "maximum": 1},
        "clarify_min": {"type": "number", "minimum": 0, "maximum": 1},
        "abstain_below": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration_version": {"type": ["string", "null"], "maxLength": 64}
      },
      "additionalProperties": false
    },
    "executed_action": {"type": "string", "enum": ["accept", "clarify", "escalate", "reject"]},
    "component_versions": {
      "type": "object",
      "required": ["candidate_retriever", "evidence_assembler", "calibrator", "selective_policy"],
      "properties": {
        "candidate_retriever": {"type": "string", "maxLength": 64},
        "evidence_assembler": {"type": "string", "maxLength": 64},
        "calibrator": {"type": ["string", "null"], "maxLength": 64},
        "selective_policy": {"type": "string", "maxLength": 64}
      },
      "additionalProperties": false
    },
    "budget_snapshot": {
      "type": "object",
      "required": ["model_calls", "input_tokens", "output_tokens", "estimated_cost_cny", "elapsed_ms"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_cny": {"type": "number", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
