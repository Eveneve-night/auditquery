{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-pack-manifest.v1",
  "title": "Domain pack manifest v1",
  "type": "object",
  "required": [
    "domain_pack_id",
    "domain_id",
    "version",
    "schema_version",
    "content_schema_id",
    "language",
    "created_at",
    "data_level",
    "source_refs",
    "license",
    "compatibility",
    "hash_algorithm",
    "files"
  ],
  "properties": {
    "domain_pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "domain_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"const": "1.0.0"},
    "content_schema_id": {"const": "domain-pack-content.v1"},
    "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "created_at": {"type": "string", "format": "date-time"},
    "data_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["source_id", "uri", "license", "data_level", "authorized"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "uri": {"type": "string", "minLength": 1, "maxLength": 512},
          "license": {"type": "string", "minLength": 1, "maxLength": 128},
          "data_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
          "authorized": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "required": ["spdx_id", "redistribution_allowed", "notice_path"],
      "properties": {
        "spdx_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "redistribution_allowed": {"type": "boolean"},
        "notice_path": {"const": "LICENSE-or-SOURCE.md"}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["task_types", "database_versions"],
      "properties": {
        "task_types": {
          "type": "array",
          "items": {"type": "string", "enum": ["intent", "clarification", "nl2sql", "grounded_answer"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "database_versions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "hash_algorithm": {"const": "sha256-utf8-lf"},
    "files": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256", "data_level", "send_to_model"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["concepts", "aliases", "slots", "schema_catalog", "relations", "value_evidence", "validation_rules", "license_notice"]
          },
          "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "data_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
          "send_to_model": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
