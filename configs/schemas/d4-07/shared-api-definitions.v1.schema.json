{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-api-definitions.v1.schema.json",
  "title": "D4-07 shared online API definitions v1",
  "$defs": {
    "bounded_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ref_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "submit_query_request": {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "session_id",
        "request_id",
        "turn_id",
        "state_revision",
        "query"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "operation": {"const": "submit_query"},
        "session_id": {"$ref": "#/$defs/bounded_id"},
        "request_id": {"$ref": "#/$defs/bounded_id"},
        "turn_id": {"$ref": "#/$defs/bounded_id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "query": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "submit_clarification_request": {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "session_id",
        "request_id",
        "turn_id",
        "state_revision",
        "question_id",
        "slot_id",
        "values",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "operation": {"const": "submit_clarification"},
        "session_id": {"$ref": "#/$defs/bounded_id"},
        "request_id": {"$ref": "#/$defs/bounded_id"},
        "turn_id": {"$ref": "#/$defs/bounded_id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "question_id": {"$ref": "#/$defs/bounded_id"},
        "slot_id": {"$ref": "#/$defs/ref_id"},
        "values": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_id"},
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "online_request": {
      "oneOf": [
        {"$ref": "#/$defs/submit_query_request"},
        {"$ref": "#/$defs/submit_clarification_request"}
      ]
    },
    "thresholds": {
      "type": "object",
      "required": ["accept_min", "clarify_min", "abstain_below", "retrieval_min_score"],
      "properties": {
        "accept_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "clarify_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "abstain_below": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "retrieval_min_score": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "contract_version",
        "action",
        "reason_code",
        "score_kind",
        "raw_score",
        "calibration_version",
        "thresholds",
        "evidence_refs",
        "missing_or_conflicting_slots",
        "accept_authorizes_sql_execution",
        "requires_d4_02_safety_gate"
      ],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "action": {"enum": ["accept", "clarify", "escalate", "reject"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "score_kind": {"enum": ["uncalibrated_raw_score", "deterministic_rule", "deterministic_bm25"]},
        "raw_score": {"type": ["number", "null"], "minimum": 0},
        "calibration_version": {"type": ["string", "null"], "maxLength": 64},
        "thresholds": {"$ref": "#/$defs/thresholds"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_id"},
          "maxItems": 32,
          "uniqueItems": true
        },
        "missing_or_conflicting_slots": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_id"},
          "maxItems": 16,
          "uniqueItems": true
        },
        "accept_authorizes_sql_execution": {"const": false},
        "requires_d4_02_safety_gate": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "display_name", "candidate_kind", "score", "evidence_refs"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/ref_id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "candidate_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "score": {"type": "number", "minimum": 0},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_id"},
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "pending_question": {
      "type": "object",
      "required": [
        "question_id",
        "session_id",
        "request_id",
        "turn_id",
        "state_revision",
        "slot_id",
        "question_text"
      ],
      "properties": {
        "question_id": {"$ref": "#/$defs/bounded_id"},
        "session_id": {"$ref": "#/$defs/bounded_id"},
        "request_id": {"$ref": "#/$defs/bounded_id"},
        "turn_id": {"$ref": "#/$defs/bounded_id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "slot_id": {"$ref": "#/$defs/ref_id"},
        "question_text": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "sql_result": {
      "type": "object",
      "required": [
        "proposal_id",
        "candidate_sql",
        "tables",
        "safety_status",
        "execution_attempts",
        "columns",
        "rows",
        "row_count",
        "truncated"
      ],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/ref_id"},
        "candidate_sql": {"type": "string", "minLength": 1, "maxLength": 4096},
        "tables": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "safety_status": {"enum": ["not_attempted", "approved", "rejected"]},
        "execution_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "columns": {
          "type": "array",
          "items": {"type": "string", "maxLength": 128},
          "maxItems": 64
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": ["string", "number", "integer", "boolean", "null"]},
            "maxItems": 64
          },
          "maxItems": 100
        },
        "row_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "required": ["evidence_id", "document_id", "document_title", "page", "snippet", "score"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/ref_id"},
        "document_id": {"$ref": "#/$defs/ref_id"},
        "document_title": {"type": "string", "minLength": 1, "maxLength": 128},
        "page": {"type": "integer", "minimum": 1, "maximum": 10000},
        "snippet": {"type": "string", "minLength": 1, "maxLength": 240},
        "score": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "trace_event": {
      "type": "object",
      "required": ["sequence", "stage", "action", "reason_code", "evidence_refs", "artifact_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 128},
        "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "action": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "reason_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/ref_id"},
          "maxItems": 32,
          "uniqueItems": true
        },
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["model_calls", "input_tokens", "output_tokens", "estimated_cost_cny", "elapsed_ms", "stopped_reason"],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_cny": {"type": "number", "minimum": 0},
        "elapsed_ms": {"type": "number", "minimum": 0},
        "stopped_reason": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,63}$"}
      },
      "additionalProperties": false
    },
    "safe_error": {
      "type": "object",
      "required": ["code", "retryable", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "retryable": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "online_response": {
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "request_id",
        "turn_id",
        "state_revision",
        "route",
        "status",
        "message",
        "decision",
        "pending_question",
        "candidate_evidence",
        "sql",
        "citations",
        "trace",
        "usage",
        "error",
        "warnings"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "session_id": {"$ref": "#/$defs/bounded_id"},
        "request_id": {"$ref": "#/$defs/bounded_id"},
        "turn_id": {"$ref": "#/$defs/bounded_id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "route": {"enum": ["sql", "rag", "clarification", "unknown"]},
        "status": {"enum": ["success", "clarification_required", "refused", "error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 256},
        "decision": {"oneOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]},
        "pending_question": {"oneOf": [{"$ref": "#/$defs/pending_question"}, {"type": "null"}]},
        "candidate_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate"},
          "maxItems": 10
        },
        "sql": {"oneOf": [{"$ref": "#/$defs/sql_result"}, {"type": "null"}]},
        "citations": {
          "type": "array",
          "items": {"$ref": "#/$defs/citation"},
          "maxItems": 10
        },
        "trace": {
          "type": "array",
          "items": {"$ref": "#/$defs/trace_event"},
          "maxItems": 64
        },
        "usage": {"$ref": "#/$defs/usage"},
        "error": {"oneOf": [{"$ref": "#/$defs/safe_error"}, {"type": "null"}]},
        "warnings": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "clarification_required"}}},
          "then": {
            "properties": {
              "decision": {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"action": {"const": "clarify"}}}]},
              "pending_question": {"$ref": "#/$defs/pending_question"},
              "sql": {"type": "null"},
              "error": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "error"}}},
          "then": {
            "properties": {
              "decision": {"type": "null"},
              "pending_question": {"type": "null"},
              "sql": {"type": "null"},
              "citations": {"maxItems": 0},
              "error": {"$ref": "#/$defs/safe_error"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["success", "refused"]}}},
          "then": {
            "properties": {
              "decision": {"$ref": "#/$defs/decision"},
              "pending_question": {"type": "null"},
              "error": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
