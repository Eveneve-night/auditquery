{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-layer-contract.v1.schema.json",
  "title": "D5-00 independent deployment product layer contract v1",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "api_version",
    "api_schema",
    "compatibility",
    "model_boundary",
    "roles",
    "error_catalog",
    "endpoints",
    "security",
    "audit",
    "data_classes",
    "store_interfaces",
    "pdf_lifecycle",
    "threats",
    "implementation_status"
  ],
  "properties": {
    "contract_id": {"const": "d5-product-layer"},
    "contract_version": {"const": "1.0.0"},
    "api_version": {"const": "3.0"},
    "api_schema": {"const": "api-v3.schema.json"},
    "compatibility": {
      "type": "object",
      "required": ["previous_api", "strategy", "breaking_change_rule"],
      "properties": {
        "previous_api": {"const": "2.0"},
        "strategy": {"const": "parallel_versioned_routes"},
        "breaking_change_rule": {"const": "new_major_api_or_contract_version"}
      },
      "additionalProperties": false
    },
    "model_boundary": {
      "type": "object",
      "required": ["provider", "model", "fallback", "dynamic_routing", "admin_mutable"],
      "properties": {
        "provider": {"const": "bailian_beijing"},
        "model": {"const": "qwen3.7-flash"},
        "fallback": {"const": false},
        "dynamic_routing": {"const": false},
        "admin_mutable": {"const": false}
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"enum": ["visitor", "admin", "bootstrap"]},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "error_catalog": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["code", "http_status", "safe_message", "retryable"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "http_status": {"type": "integer", "minimum": 400, "maximum": 599},
          "safe_message": {"type": "string", "minLength": 1, "maxLength": 160},
          "retryable": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "roles", "auth", "csrf", "ownership", "request_schema", "response_schema", "errors"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "method": {"enum": ["GET", "POST", "PUT", "DELETE"]},
          "path": {"type": "string", "pattern": "^/api/v3/"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["visitor", "admin", "bootstrap"]}},
          "auth": {"enum": ["anonymous", "visitor_session", "admin_session", "bootstrap_token", "login_credentials"]},
          "csrf": {"enum": ["required", "not_applicable"]},
          "ownership": {"enum": ["own_session", "admin_global", "bootstrap_only", "none"]},
          "request_schema": {"type": ["string", "null"]},
          "response_schema": {"type": "string", "minLength": 1},
          "errors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "required": ["admin_bootstrap", "visitor_session", "admin_session", "csrf", "rate_limits", "api_key"],
      "properties": {
        "admin_bootstrap": {"$ref": "#/$defs/rules"},
        "visitor_session": {"$ref": "#/$defs/rules"},
        "admin_session": {"$ref": "#/$defs/rules"},
        "csrf": {"$ref": "#/$defs/rules"},
        "rate_limits": {"$ref": "#/$defs/rules"},
        "api_key": {"$ref": "#/$defs/rules"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["event_types", "allowed_fields", "forbidden_fields", "retention_days", "append_only"],
      "properties": {
        "event_types": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "allowed_fields": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_fields": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "append_only": {"const": true}
      },
      "additionalProperties": false
    },
    "data_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "examples", "storage", "audit", "backup"],
        "properties": {
          "id": {"enum": ["public", "internal", "sensitive", "secret"]},
          "examples": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "storage": {"type": "string", "minLength": 1},
          "audit": {"type": "string", "minLength": 1},
          "backup": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "store_interfaces": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "operations", "transaction", "concurrency", "restart_recovery", "failure_semantics"],
        "properties": {
          "id": {"enum": ["AuthStore", "MetadataStore", "DocumentStore", "SecretStore"]},
          "operations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
          "transaction": {"type": "string", "minLength": 1},
          "concurrency": {"type": "string", "minLength": 1},
          "restart_recovery": {"type": "string", "minLength": 1},
          "failure_semantics": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "pdf_lifecycle": {
      "type": "object",
      "required": ["version", "states", "validation_order", "limits", "publish", "failure"],
      "properties": {
        "version": {"const": "1.0.0"},
        "states": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "validation_order": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "limits": {
          "type": "object",
          "required": ["max_file_bytes", "max_pages", "parse_timeout_seconds"],
          "properties": {
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_pages": {"type": "integer", "minimum": 1},
            "parse_timeout_seconds": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "publish": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "threats": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "threat", "control", "test_owner", "required_test"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-D5-[0-9]{2}$"},
          "threat": {"type": "string", "minLength": 1},
          "control": {"type": "string", "minLength": 1},
          "test_owner": {"enum": ["A", "B", "C", "B+C"]},
          "required_test": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "implementation_status": {"const": "contract_only_not_implemented"}
  },
  "$defs": {
    "rules": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
