{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "admin-bootstrap-contract.v2.schema.json",
  "title": "D5 default administrator bootstrap contract v2",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "effective_date",
    "authorization",
    "supersedes",
    "api",
    "initial_credentials",
    "lifecycle",
    "deployment_guard",
    "confidentiality",
    "migration",
    "implementation_status"
  ],
  "properties": {
    "contract_id": {"const": "d5-admin-bootstrap"},
    "contract_version": {"const": "2.0.0"},
    "effective_date": {"const": "2026-10-13"},
    "authorization": {"const": "human_owner_explicit_baseline_change"},
    "supersedes": {
      "type": "object",
      "required": ["contract", "contract_version", "scope", "retained"],
      "properties": {
        "contract": {"const": "product-layer.v1.json"},
        "contract_version": {"const": "1.0.0"},
        "scope": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "retained": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "required": ["route_major", "schema", "transport_contract_version"],
      "properties": {
        "route_major": {"const": "v3"},
        "schema": {"const": "admin-bootstrap-api.v2.schema.json"},
        "transport_contract_version": {"const": "2.0.0"}
      },
      "additionalProperties": false
    },
    "initial_credentials": {
      "type": "object",
      "required": ["username", "initial_password", "create_only_when", "password_storage", "must_change_password", "password_change_policy"],
      "properties": {
        "username": {"const": "admin"},
        "initial_password": {"const": "ictagent123"},
        "create_only_when": {"const": "auth_store_empty"},
        "password_storage": {"const": "argon2id_hash_only"},
        "must_change_password": {"const": false},
        "password_change_policy": {"const": "optional"}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["initialization", "authenticated_session", "password_change", "restart_and_recovery"],
      "properties": {
        "initialization": {"$ref": "#/$defs/rules"},
        "authenticated_session": {"$ref": "#/$defs/rules"},
        "password_change": {"$ref": "#/$defs/rules"},
        "restart_and_recovery": {"$ref": "#/$defs/rules"}
      },
      "additionalProperties": false
    },
    "deployment_guard": {
      "type": "object",
      "required": ["default_bind", "rules"],
      "properties": {
        "default_bind": {"const": "127.0.0.1"},
        "rules": {"$ref": "#/$defs/rules"}
      },
      "additionalProperties": false
    },
    "confidentiality": {
      "type": "object",
      "required": ["forbidden_sinks", "frontend_rules"],
      "properties": {
        "forbidden_sinks": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"enum": ["log", "audit", "http_response", "frontend_state", "browser_storage", "cookie", "url", "screenshot", "machine_report", "backup_export"]}
        },
        "frontend_rules": {"$ref": "#/$defs/rules"}
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": ["v1_empty_store", "v1_initialized_store", "consumer_impact"],
      "properties": {
        "v1_empty_store": {"type": "string", "minLength": 1},
        "v1_initialized_store": {"type": "string", "minLength": 1},
        "consumer_impact": {
          "type": "object",
          "required": ["B", "C"],
          "properties": {"B": {"type": "string", "minLength": 1}, "C": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "implementation_status": {"const": "contract_only_b_and_c_runtime_pending"}
  },
  "$defs": {
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
