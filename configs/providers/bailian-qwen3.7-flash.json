{
  "provider_id": "bailian-cn-beijing",
  "provider_name": "Alibaba Cloud Model Studio (Bailian)",
  "region": "cn-beijing",
  "workspace_type": "default",
  "protocol": "openai-compatible-chat-completions",
  "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
  "model": "qwen3.7-flash",
  "request": {
    "stream": false,
    "temperature": 0,
    "max_completion_tokens": 64,
    "enable_thinking": false,
    "timeout_seconds": 30
  },
  "runtime": {
    "timeout_seconds": 10,
    "max_completion_tokens_cap": 1500,
    "max_response_bytes": 2097152,
    "require_response_model_match": true
  },
  "pricing_snapshot": {
    "date": "2026-09-23",
    "currency": "CNY",
    "input_per_million_tokens": 0.2,
    "output_per_million_tokens": 0.8,
    "applies_when_input_tokens_lte": 32000,
    "source": "https://help.aliyun.com/zh/model-studio/model-pricing"
  },
  "credential": {
    "source": "external_file",
    "copy_into_project": false,
    "log_secret": false
  }
}
